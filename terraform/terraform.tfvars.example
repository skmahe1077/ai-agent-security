# Copy to terraform.tfvars if you want to override any default -- but note
# that EVERY variable in variables.tf already has a default. Unlike the old
# Vault-based talk (which required a Vault Enterprise license secret before
# the first apply), this stack needs ZERO required tfvars: dropping Vault
# dropped the one out-of-band prerequisite along with it.
#
# Never commit the real file -- it's already in .gitignore.

# aws_region = "eu-west-1"
# name       = "kubecon-agent-demo"

# The storefront ALB is public and /api/admin/reset is unauthenticated --
# narrow this to your current IP right before the talk:
#   curl -s ifconfig.me
# alb_inbound_cidrs = ["203.0.113.4/32"]
